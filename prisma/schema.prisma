generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  USER
}

enum ShowStatus {
  CONFIRMADO
  EM_REVISAO
  CANCELADO
  REALIZADO
}

enum TipoLocal {
  PUBLICO
  PRIVADO
}

enum TipoEntrada {
  VALOR
  PERCENTUAL
}

enum TipoDocumentoFiscal {
  CPF
  CNPJ
  RG
}

model User {
  id           Int      @id @default(autoincrement())
  nome         String
  email        String   @unique
  passwordHash String
  tokenVersion Int      @default(0)
  role         UserRole @default(ADMIN)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Contratante {
  id        Int      @id @default(autoincrement())
  nome      String
  cpf       String?  @unique
  tipoDocumento TipoDocumentoFiscal @default(CPF)
  email     String?  @unique
  telefone  String?
  empresa   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  shows     Show[]
}

model Local {
  id        Int      @id @default(autoincrement())
  nome      String
  endereco  String
  cidade    String
  capacidade Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  shows     Show[]
}

model Show {
  id                  Int         @id @default(autoincrement())
  titulo              String
  data                DateTime
  dataFim             DateTime
  cidade              String
  tipoLocal           TipoLocal   @default(PRIVADO)
  responsavelVenda    String?
  status              ShowStatus @default(CONFIRMADO)
  valorShow           Decimal     @default(0) @db.Decimal(10, 2)
  valorCusto          Decimal     @default(0) @db.Decimal(10, 2)
  tipoEntrada         TipoEntrada?
  valorEntrada        Decimal?    @db.Decimal(10, 2)
  numeroParcelas      Int?
  inicioPlanoPagamento DateTime?
  observacoes         String?     @db.Text
  contratanteId       Int?
  contratante         Contratante? @relation(fields: [contratanteId], references: [id], onDelete: SetNull)
  localEvento         String?     @db.VarChar(200)
  localId             Int?
  local               Local?      @relation(fields: [localId], references: [id], onDelete: SetNull)
  pagamentos          Pagamento[]
  pagamentosPrevistos PagamentoPrevisto[]
  contratos           Contrato[]
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
}

model PagamentoPrevisto {
  id            Int       @id @default(autoincrement())
  showId        Int
  show          Show      @relation(fields: [showId], references: [id], onDelete: Cascade)
  descricao     String    @db.VarChar(100)
  valor         Decimal   @db.Decimal(10, 2)
  quantidade    Int       @default(1)
  dataPrevista  DateTime? @db.Date
  isEntrada     Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([showId, dataPrevista])
}

model Pagamento {
  id               Int      @id @default(autoincrement())
  showId           Int
  show             Show     @relation(fields: [showId], references: [id], onDelete: Cascade)
  valor            Decimal  @db.Decimal(10, 2)
  dataPagamento    DateTime @default(now())
  comprovantePath  String?
  comprovanteNome  String?
  comprovanteTipo  String?
  createdAt        DateTime @default(now())
}

model Contrato {
  id          Int      @id @default(autoincrement())
  showId      Int
  show        Show     @relation(fields: [showId], references: [id], onDelete: Cascade)
  nome        String
  arquivoPath String   @unique
  arquivoTipo String
  tamanhoBytes Int
  createdAt   DateTime @default(now())

  @@index([showId, createdAt])
}